ARG SDK_BASE

FROM ${SDK_BASE}

ARG TARGETARCH
ARG ABI_MANIFEST_PATH

# Every payload is staged at its image-relative path and copied with the
# filesystem root as the destination: buildkit re-stamps synthetic parent
# directories, and any COPY destination below /, to the build clock, so a
# directory-form COPY into / plus a stamped context is what keeps the child
# digest independent of when the image is built.
COPY --chown=65532:65532 gomodcache-root/ /
COPY --chown=0:0 stage-root/ /

# The probe runs with HOME in a scratch directory it removes in this same RUN.
# The version check is a verifier and must leave no trace in the image: with
# the inherited HOME it writes a Go telemetry counter whose file name carries
# the build date and whose contents carry the week the build ran in, which put
# the wall clock into the child digest through a layer that is supposed to
# prove the toolchain is the locked one. A file created and removed inside one
# RUN leaves the layer empty, so the digest stops depending on when it built.
RUN set -eu; \
    home=$(mktemp -d); \
    . /opt/rulego/build.env; \
    test "${TARGETARCH}" = "${GOARCH}"; \
    test "$(HOME="${home}" GOENV="${GOENV}" GOTOOLCHAIN="${GOTOOLCHAIN}" go env GOVERSION)" = "go${GO_VERSION}"; \
    test "$("${CC}" -dumpfullversion)" = "${CC_VERSION}"; \
    linker_output=$("${LINKER_COMMAND}" --version 2>&1); \
    printf '%s\n' "${linker_output}" | grep -F "${LINKER_IDENTITY}"; \
    printf '%s\n' "${linker_output}" | grep -F "${LINKER_VERSION}"; \
    test "sha256:$(sha256sum /abi-manifest.json | awk '{print $1}')" = "${LOCK_DIGEST}"; \
    cmp /abi-manifest.json "${ABI_MANIFEST_PATH}"; \
    rm -rf "${home}"

WORKDIR /workspace
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/rulego-plugin-build"]
